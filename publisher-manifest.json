-size:.78rem;letter-spacing:.04em;color:var(--muted);border-top:1px dashed var(--wine-soft);padding-top:10px}\n  .step.s1{padding-bottom:26px}\n  .step.s2{padding-bottom:40px}\n  .step.s3{padding-bottom:56px;background:var(--wine);color:var(--ivory)}\n  .step.s3 h3,.step.s3 .price{color:var(--ivory)}\n  .step.s3 .rank,.step.s3 .price small,.step.s3 ul{color:var(--ivory)}\n  .step.s3 .rank{opacity:.75}\n  .step.s3 ul{color:var(--ivory)}\n  .step.s3 .foot{color:var(--ivory);border-top-color:rgba(247,241,230,.45);opacity:.85}\n  .badge{display:inline-block;font-size:.68rem;letter-spacing:.18em;text-transform:uppercase;border:2px solid currentColor;padding:4px 10px}\n  /* 使用说明 */\n  .steps{display:grid;grid-template-columns:repeat(2,1fr);gap:18px;margin-top:8px}\n  .steps .box{padding:22px 22px 20px}\n  .steps .num{font-size:2.4rem;line-height:1;color:var(--wine-soft);font-weight:700;margin-bottom:6px}\n  .steps p{margin:0;font-size:.94rem;color:#3a2229}\n  /* 客户端区块 */\n  .clients{display:grid;grid-template-columns:1.2fr 1fr;gap:22px;margin-top:8px}\n  .clients .box p{font-size:.94rem;color:#3a2229;margin:0 0 10px}\n  .clients .box p:last-child{margin-bottom:0}\n  .clients .side{background:var(--wine);color:var(--ivory);border-color:var(--wine-deep)}\n  .clients .side p{color:var(--ivory)}\n  .clients .side h3{color:var(--ivory)}\n  /* FAQ 分组 */\n  .faq-group{margin-top:30px}\n  .faq-group > h3{font-size:.78rem;letter-spacing:.26em;text-transform:uppercase;color:var(--wine);border-bottom:2px solid var(--wine);padding-bottom:8px;margin-bottom:16px}\n  .qa{border:3px solid var(--line);background:var(--ivory-2);padding:16px 20px;margin-bottom:-3px}\n  .qa p.q{margin:0 0 8px;font-weight:700;font-size:1rem}\n  .qa p.a{margin:0;font-size:.94rem;color:#3a2229}\n  .faq-grid{display:grid;grid-template-columns:1fr 1fr;gap:0 20px;align-items:start}\n  /* 结尾 */\n  .closing{background:var(--wine-deep);color:var(--ivory);padding:clamp(30px,4.5vw,54px) 0}\n  .closing h2{color:var(--ivory);max-width:30ch}\n  .closing p{color:var(--ivory);max-width:56ch;opacity:.9;margin:0 0 14px}\n  .closing a{color:var(--ivory);border-bottom-color:rgba(247,241,230,.6)}\n  .closing a:hover{background:var(--ivory);color:var(--wine-deep)}\n  @media (max-width:980px){\n    .layout{grid-template-columns:1fr}\n    .rail{position:static;height:auto;flex-direction:row;flex-wrap:wrap;align-items:center;gap:12px 18px;padding:16px 18px}\n    .rail .mark{border-bottom:none;padding-bottom:0;font-size:1rem}\n    .rail .mark span{display:inline;margin-left:8px}\n    .rail nav{flex-direction:row;flex-wrap:wrap;gap:0 4px}\n    .rail nav a{padding:4px 8px;border-left:none;border-bottom:1px solid rgba(247,241,230,.32);font-size:.85rem}\n    .rail .note{display:none}\n    .intro-grid,.ladder,.steps,.clients,.faq-grid{grid-template-columns:1fr}\n    .step{margin-left:0;padding-bottom:24px !important}\n    .faq-grid{gap:0}\n  }\n</style><div class=\"layout\">\n  <aside class=\"rail\">\n    <div class=\"mark\">sdwanus<span>网络套餐与说明</span></div>\n    <nav>\n      <a href=\"#plans\">三档套餐</a>\n      <a href=\"#how\">怎么开始用</a>\n      <a href=\"#clients\">客户端说明</a>\n      <a href=\"#faq\">常见问题</a>\n      <a href=\"#talk\">最后聊两句</a>\n    </nav>\n    <p class=\"note\">这是一份把价格、流量和设备数摊开来讲的页面。想到什么，往下翻就行。</p>\n  </aside>\n\n  <main>\n    <header class=\"hero\">\n      <div class=\"wrap\">\n        <h1>sdwanus</h1>\n        <div class=\"sub\">\n          <p>选套餐这件事，其实不用太紧张。我们准备了三种规格，把每月流量、可同时在线的设备数和线路类型写在明面上，你可以先看看哪个跟自己日常的用量对得上。</p>\n          <span class=\"tag\">用量 · 设备 · 线路</span>\n        </div>\n      </div>\n    </header>\n\n    <section id=\"plans\">\n      <div class=\"wrap\">\n        <p class=\"eyebrow\">套餐</p>\n        <h2>从基础版开始，往上走是给更重的用量准备的</h2>\n        <p class=\"lead\">三档套餐按流量和设备数逐级递增，你可以把它当成三个台阶：先看清楚自己每个月大概会用多少，再决定站在哪一级。下面的价格和权益，就是页面上写着的全部内容。</p>\n\n        <div class=\"ladder\">\n          <article class=\"step s1\">\n            <span class=\"rank\">第一级</span>\n            <h3>基础版</h3>\n            <div class=\"price\">¥15/月<small>按年付 ¥150/年</small></div>\n            <ul>\n              <li>每月 100GB 流量</li>\n              <li>支持 3 台设备同时在线</li>\n              <li>基础流媒体解锁</li>\n              <li>普通线路节点池</li>\n            </ul>\n            <div class=\"foot\">适合一两台手机加一台电脑的轻量使用。</div>\n          </article>\n\n          <article class=\"step s2\">\n            <span class=\"rank\">第二级</span>\n            <h3>旗舰版</h3>\n            <div class=\"price\">¥35/月<small>按年付 ¥350/年</small></div>\n            <ul>\n              <li>每月 300GB 流量</li>\n              <li>支持 5 台设备同时在线</li>\n              <li>全节点原生流媒体解锁</li>\n              <li>IPLC 专线游戏加速优化</li>\n              <li>7x24 优先工单支持</li>\n            </ul>\n            <div class=\"foot\">流量和线路规格都往上抬了一档，多数人会停在这里。</div>\n          </article>\n\n          <article class=\"step s3\">\n            <span class=\"rank\">第三级</span>\n            <h3>团队版</h3>\n            <div class=\"price\">¥85/月<small>按年付 ¥850/年</small></div>\n            <ul>\n              <li>每月 1000GB 流量</li>\n              <li>支持 20 台设备同时在线</li>\n              <li>VIP 专属高带宽节点</li>\n              <li>支持企业定制路由</li>\n              <li>专属客户经理服务</li>\n            </ul>\n            <div class=\"foot\"><span class=\"badge\">设备数最多</span></div>\n          </article>\n        </div>\n      </div>\n    </section>\n\n    <section id=\"how\">\n      <div class=\"wrap\">\n        <p class=\"eyebrow\">开始使用</p>\n        <h2>四步，不多不少</h2>\n        <p class=\"lead\">流程本身没什么玄机，下面按顺序写，照着走一遍，你就知道自己在哪一步。</p>\n\n        <div class=\"intro-grid\">\n          <div class=\"box\">\n            <h3>先看用量</h3>\n            <p>翻一下自己上个月的流量大概是多少，再看平时会同时开几台设备。这两个数字基本决定了你该从哪一档开始。</p>\n          </div>\n          <div class=\"box\">\n            <h3>再选档位</h3>\n            <p>基础版、旗舰版、团队版之间是逐级递进的关系，不是互相替代。选高了浪费，选低了会碰上限，按平时用量挑就好。</p>\n          </div>\n          <div class=\"box\">\n            <h3>确认周期</h3>\n            <p>月付和年付两种周期在价格上不同，年付的金额写在每档旁边。到期前请留意自己的周期，避免用到一半才发现。</p>\n          </div>\n        </div>\n\n        <div class=\"steps\">\n          <div class=\"box\">\n            <div class=\"num\">1</div>\n            <h3>把需求写下来</h3>\n            <p>先在纸上或备忘录里写下：每月大概多少流量、最多几台设备、是否要跑游戏。写清楚之后，三个套餐里通常只剩一个还站得住。</p>\n          </div>\n          <div class=\"box\">\n            <div class=\"num\">2</div>\n            <h3>对照套餐权益</h3>\n            <p>把写下来的需求和套餐里的流量、设备数、线路类型逐条对一遍。对不上的地方，就是你需要问清楚的地方。</p>\n          </div>\n          <div class=\"box\">\n            <div class=\"num\">3</div>\n            <h3>按设备装上客户端</h3>\n            <p>设备数量由套餐规定，超过上限的部分不会同时生效。先在主力设备上装好并使用一段时间，再决定要不要加第二台。</p>\n          </div>\n          <div class=\"box\">\n            <div class=\"num\">4</div>\n            <h3>用一段时间再判断</h3>\n            <p>第一个周期内多留意流量消耗速度和设备数的实际占用，这比任何说明都准确。下个周期再决定要不要换档。</p>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <section id=\"clients\">\n      <div class=\"wrap\">\n        <p class=\"eyebrow\">客户端</p>\n        <h2>装在设备上，然后就不用总想着它</h2>\n        <p class=\"lead\">客户端按你使用的设备系统来选。这里只讲选择思路，不给出具体下载地址，以免你从不对的地方拿到文件。</p>\n\n        <div class=\"clients\">\n          <div class=\"box\">\n            <h3>怎么挑客户端</h3>\n            <p>先确认自己设备的系统类型，再选对应版本。桌面端和移动端的界面不同，但账号和套餐是同一套，不需要分开购买。</p>\n            <p>同一个套餐下的设备数上限是所有客户端共用的。三台设备同时在线，就是三台，不会因为换了系统而多出一个名额。</p>\n            <p>如果对版本有疑问，先别急着装，把设备型号记下来再去问，比装错了再卸掉省事。</p>\n          </div>\n          <div class=\"box side\">\n            <h3>几点提醒</h3>\n            <p>客户端本身不改变套餐规格。流量用完了，换客户端也不会变多。</p>\n            <p>请从你信任的渠道获取安装文件。本页不提供下载链接，也不代发任何安装包。</p>\n            <p>换设备前，先退出旧设备，避免名额被占住。</p>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <section id=\"faq\">\n      <div class=\"wrap\">\n        <p class=\"eyebrow\">常见问题</p>\n        <h2>按主题分了三组，挑你想看的那组</h2>\n        <p class=\"lead\">问题大多是围绕价格、流量和设备数展开的。如果看完还有没覆盖到的，可以在页面末尾找到继续问的方式。</p>\n\n        <div class=\"faq-group\">\n          <h3>关于套餐与价格</h3>\n          <div class=\"faq-grid\">\n            <div class=\"qa\">\n              <p class=\"q\">三档套餐是按用量叠加的吗？</p>\n              <p class=\"a\">不是叠加，是递进。你选其中一档，就按那一档的流量、设备数和线路来用。基础版不会因为付了旗舰版的钱而变成两倍流量。</p>\n            </div>\n            <div class=\"qa\">\n              <p class=\"q\">年付的价格是怎么算的？</p>\n              <p class=\"a\">年付金额直接写在每档套餐的月价下方：基础版 ¥150/年、旗舰版 ¥350/年、团队版 ¥850/年。它是按年一次性结算的周期价格，不是把月费打折后按月扣。</p>\n            </div>\n            <div class=\"qa\">\n              <p class=\"q\">用超了流量会怎样？</p>\n              <p class=\"a\">每档套餐都有明确的月度流量上限，达到上限后当月无法继续按原规格使用。页面不承诺任何超量后的额外处理方式，所以请按实际用量选档，别把上限当参考值。</p>\n            </div>\n            <div class=\"qa\">\n              <p class=\"q\">团队版是不是一定要企业才能买？</p>\n              <p class=\"a\">团队版的核心差别在流量、设备数和定制路由这几项规格上。它适合设备多、流量大的场景，并没有在页面上附加企业身份的门槛说明。</p>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"faq-group\">\n          <h3>关于设备与客户端</h3>\n          <div class=\"faq-grid\">\n            <div class=\"qa\">\n              <p class=\"q\">设备数上限是怎么算的？</p>\n              <p class=\"a\">按同时在线计算。基础版 3 台、旗舰版 5 台、团队版 20 台。同一时间超过这个数量，多出来的设备就无法同时使用。</p>\n            </div>\n            <div class=\"qa\">\n              <p class=\"q\">换设备需要重新买套餐吗？</p>\n              <p class=\"a\">不需要。套餐跟账号绑定，不跟某一台设备绑定。你只要在新设备上登录，并注意旧设备是否还占着一个名额。</p>\n            </div>\n            <div class=\"qa\">\n              <p class=\"q\">页面为什么不给下载链接？</p>\n              <p class=\"a\">因为我们没有可确认的官方下载地址，宁可不写，也不给你一个可能拿错文件的入口。安装文件请以你自己信任的来源为准。</p>\n            </div>\n            <div class=\"qa\">\n              <p class=\"q\">不同客户端的流量是分开算的吗？</p>\n              <p class=\"a\">不是。流量是一个账号下一个池子，无论从哪台设备、哪个客户端走，都从同一个月度额度里扣。</p>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"faq-group\">\n          <h3>关于线路与使用体验</h3>\n          <div class=\"faq-grid\">\n            <div class=\"qa\">\n              <p class=\"q\">普通线路节点池和 VIP 节点有什么区别？</p>\n              <p class=\"a\">套餐列表里，基础版对应普通线路节点池，团队版对应 VIP 专属高带宽节点，旗舰版则写明包含 IPLC 专线游戏加速优化。具体到某一时段的实际表现，页面不做数字承诺。</p>\n            </div>\n            <div class=\"qa\">\n              <p class=\"q\">流媒体解锁是所有套餐都一样吗？</p>\n              <p class=\"a\">不一样。基础版是基础流媒体解锁，旗舰版写明全节点原生流媒体解锁，团队版没有单独标注这一项。如果你很在意这一点，选档时请把它算进去。</p>\n            </div>\n            <div class=\"qa\">\n              <p class=\"q\">支持能到什么程度？</p>\n              <p class=\"a\">旗舰版写明 7x24 优先工单支持，团队版写明专属客户经理服务。基础版没有单独的优先支持说明。需要快速被响应的话，这两项差别值得考虑。</p>\n            </div>\n            <div class=\"qa\">\n              <p class=\"q\">可以先试一档再换吗？</p>\n              <p class=\"a\">档位是按周期结算的，本页不对跨档的折算或退补做承诺。比较稳妥的做法是先按月付选一档，用满一个周期、看清自己的实际用量，再决定下一周期用哪一档。</p>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"closing\" id=\"talk\">\n      <div class=\"wrap\">\n        <h2>说到底，选套餐就是选一个和自己用量匹配的上限</h2>\n        <p>流量、设备数、线路类型，三样东西摆在一起，答案通常自己就浮出来了。你不需要一次选对，只需要先选一个能对得上当下用量的档位。</p>\n        <p>如果还有页面没覆盖到的问题，可以把你的设备数量和大概的月用量记下来，再回来对照上面的三档套餐看一眼。剩下的，交给时间验证。</p>\n        <p><a href=\"#plans\">回到三档套餐再对一遍</a></p>\n      </div>\n    </section>\n  </main>\n</div>",
